APP_ENV=development
# Local SQLite default. For docker-compose PostgreSQL use:
# DATABASE_URL=postgresql+psycopg://harvestguard:local_dev_only_change_me@localhost:5432/harvestguard
DATABASE_URL=sqlite:///./harvestguard.db
CORS_ORIGINS=http://localhost:3000
# Set a long random secret before enabling production device ingestion.
# DEVICE_API_KEY=replace_with_a_long_random_secret
